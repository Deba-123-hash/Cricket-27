# Unreal Engine .gitignore
# Binaries and intermediate build files
Binaries/*
Intermediate/*
DerivedDataCache/*
Saved/*
Build/*
!Build/Scripts/*

# IDE and build tool files
.vs/
.vscode/
*.VC.db
*.opendb
*.sln
*.suo
*.user
*.code-workspace

# Autogenerated files
*.csproj
*.unityproj
*.sln.docstates

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Crash logs & dumps
*.log
*.dmp
*.crashinfo

# Backup files
*.bak
*.orig
*.swp
*~
